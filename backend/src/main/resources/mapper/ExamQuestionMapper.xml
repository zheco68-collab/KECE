<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kece.exam.mapper.ExamQuestionMapper">

    <resultMap id="BaseResultMap" type="com.kece.exam.entity.ExamQuestion">
        <id column="id" property="id"/>
        <result column="exam_id" property="examId"/>
        <result column="question_id" property="questionId"/>
        <result column="question_type" property="questionType"/>
        <result column="title" property="title"/>
        <result column="score" property="score"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `exam_question` (exam_id, question_id, question_type, title, score, sort_order)
        VALUES (#{examId}, #{questionId}, #{questionType}, #{title}, #{score}, #{sortOrder})
    </insert>

    <delete id="deleteByExamId">
        DELETE FROM `exam_question` WHERE exam_id = #{examId}
    </delete>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM `exam_question` WHERE id = #{id}
    </select>

    <select id="findByExamId" resultMap="BaseResultMap">
        SELECT * FROM `exam_question` WHERE exam_id = #{examId} ORDER BY sort_order ASC, id ASC
    </select>

</mapper>
