<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kece.database.mapper.DbTestCaseMapper">

    <resultMap id="BaseResultMap" type="com.kece.database.entity.DbTestCase">
        <id column="id" property="id"/>
        <result column="question_id" property="questionId"/>
        <result column="case_order" property="caseOrder"/>
        <result column="seed_sql" property="seedSql"/>
        <result column="is_sample" property="isSample"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `db_test_case` (question_id, case_order, seed_sql, is_sample)
        VALUES (#{questionId}, #{caseOrder}, #{seedSql}, #{isSample})
    </insert>

    <select id="findByQuestionId" resultMap="BaseResultMap">
        SELECT * FROM `db_test_case` WHERE question_id = #{questionId} ORDER BY case_order, id
    </select>

    <select id="findSampleCaseIds" resultType="long">
        SELECT id FROM `db_test_case` WHERE question_id = #{questionId} AND is_sample = 1
    </select>

    <delete id="deleteByQuestionId">
        DELETE FROM `db_test_case` WHERE question_id = #{questionId}
    </delete>

</mapper>
