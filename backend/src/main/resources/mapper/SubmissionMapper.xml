<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kece.submission.mapper.SubmissionMapper">

    <resultMap id="BaseResultMap" type="com.kece.submission.entity.Submission">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="question_id" property="questionId"/>
        <result column="contest_id" property="contestId"/>
        <result column="language" property="language"/>
        <result column="code_content" property="codeContent"/>
        <result column="status" property="status"/>
        <result column="score" property="score"/>
        <result column="time_used_ms" property="timeUsedMs"/>
        <result column="memory_used_kb" property="memoryUsedKb"/>
        <result column="error_log" property="errorLog"/>
        <result column="result_json" property="resultJson"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `submission`
            (user_id, question_id, contest_id, language, code_content, status)
        VALUES
            (#{userId}, #{questionId}, #{contestId}, #{language}, #{codeContent}, #{status})
    </insert>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM `submission` WHERE id = #{id}
    </select>

    <select id="findPage" resultType="com.kece.submission.dto.SubmissionListVO">
        SELECT s.id AS submissionId,
               s.question_id AS questionId,
               q.title AS questionTitle,
               s.language AS language,
               s.code_content AS codeContent,
               s.status AS status,
               s.score AS score,
               s.time_used_ms AS timeUsedMs,
               s.memory_used_kb AS memoryUsedKb,
               s.created_at AS createdAt
        FROM `submission` s
        LEFT JOIN `question` q ON q.id = s.question_id
        <where>
            <if test="userId != null">s.user_id = #{userId}</if>
            <if test="status != null and status != ''">AND s.status = #{status}</if>
        </where>
        ORDER BY s.id DESC
        LIMIT #{offset}, #{size}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM `submission` s
        <where>
            <if test="userId != null">s.user_id = #{userId}</if>
            <if test="status != null and status != ''">AND s.status = #{status}</if>
        </where>
    </select>

    <update id="updateResult">
        UPDATE `submission`
        <set>
            <if test="status != null">status = #{status},</if>
            <if test="score != null">score = #{score},</if>
            <if test="timeUsedMs != null">time_used_ms = #{timeUsedMs},</if>
            <if test="memoryUsedKb != null">memory_used_kb = #{memoryUsedKb},</if>
            <if test="errorLog != null">error_log = #{errorLog},</if>
            <if test="resultJson != null">result_json = #{resultJson},</if>
        </set>
        WHERE id = #{id}
    </update>

</mapper>
